# ==============================================================================
# TeamForge Environment Variables
# ==============================================================================

# Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public API Key (Found in Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Application base URL (Defaults to http://localhost:3000 in development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# High-Concurrency Database Connection Pooling (1000+ Concurrent Users)
# Always use Port 6543 (Supavisor Transaction Pooler) instead of Port 5432 (Session Mode)
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Transaction Mode (Port 6543)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
